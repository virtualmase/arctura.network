{
  "name": "arctura-network",
  "version": "1.0.0",
  "description": "Arctura Network \u2014 practical intelligence, tools, and evidence for accountable AI agents",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run publish:experience && npm run validate:seo",
    "test": "node --test",
    "test:worker": "node scripts/validate-network-worker.mjs",
    "validate:publishing": "node scripts/validate-published-routes.mjs",
    "validate:edge": "node scripts/validate-edge-static.mjs",
    "validate:work-order": "node scripts/validate-work-order.mjs",
    "publish:work-standard": "node scripts/publish-work-standard.mjs",
    "publish:agent-guide": "node scripts/publish-agent-field-guide.mjs",
    "publish:content": "npm run publish:work-standard && npm run publish:agent-guide && npm run publish:experience",
    "audit:live": "node scripts/audit-live-site.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "publish:experience": "node scripts/publish-experience.mjs",
    "collect:signals": "python3 scripts/collect-signals.py"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "wrangler": "4.40.0"
  }
}
